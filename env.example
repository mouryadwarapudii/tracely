# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Signs session cookies. Required.
TRACELY_SECRET=

# ClickHouse credentials, shared by the database and the app. Required.
TRACELY_CLICKHOUSE_USER=tracely
TRACELY_CLICKHOUSE_PASSWORD=

# The URL people use to open Tracely. Used in alert links.
TRACELY_PUBLIC_URL=http://localhost:3000
TRACELY_PORT=3000

# Days of telemetry to keep. Applied when the table is first created.
TRACELY_RETENTION_DAYS=90

# Optional: lets an external scheduler call POST /api/cron/evaluate.
TRACELY_CRON_SECRET=

# Session cookies are HTTPS-only in production. Set to 1 only if you must
# serve Tracely over plain HTTP on a non-localhost address (not recommended).
TRACELY_INSECURE_COOKIES=
